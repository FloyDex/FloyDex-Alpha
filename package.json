{
  "name": "floydex",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/FloyDex/FloyDex-Alpha.git"
  },
  "homepage": "https://github.com/FloyDex/FloyDex-Alpha",
  "scripts": {
    "build": "RUSTUP_TOOLCHAIN=1.96.1 anchor build",
    "build:bench": "cargo build-sbf --manifest-path programs/floydex-perps/Cargo.toml --features bench --sbf-out-dir target/deploy-bench",
    "lint": "prettier */*.js \"*/**/*{.js,.ts}\" --check",
    "e2e": "scripts/e2e-local.sh",
    "test:sdk": "cd sdk && node --test \"test/**/*.test.ts\"",
    "test:program": "cargo test --manifest-path integration/Cargo.toml",
    "backtest": "scripts/backtest/weekend_replay.py --out docs/backtest/weekend-replay.md",
    "devnet:gate": "scripts/devnet-gate.sh"
  },
  "dependencies": {
    "@coral-xyz/anchor": "^0.31.1",
    "@solana/spl-token": "^0.4.9",
    "@solana/web3.js": "^1.98.0"
  },
  "devDependencies": {
    "@types/bn.js": "^5.1.0",
    "@types/chai": "^4.3.0",
    "@types/mocha": "^9.0.0",
    "chai": "^4.3.4",
    "mocha": "^9.0.3",
    "prettier": "^2.6.2",
    "ts-mocha": "^10.0.0",
    "typescript": "^5.7.3"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
