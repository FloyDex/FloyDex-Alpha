# Copy to the repo-root `.env` and fill in values. That is the only env file.
# Next, keepers, and tsx scripts all load that one file. Root `.env` wins.
# In Railway production: inject SECRET_* vars via the Railway Secrets UI
# (Variables → add secret) and reference them as ${{secret:VAR_NAME}}.

# ── Database (server-side only — never expose to browser) ─────────────────────
# The navbar network toggle routes each API request to the selected network's
# database, so the app needs one connection string per network it offers.
#
# DATABASE_URL (unsuffixed) is the legacy single-network var and is treated as
# belonging to NEXT_PUBLIC_STELLAR_NETWORK, so an existing deployment that sets
# only this keeps working. Add the other network's URL to light up the toggle.
#
# There is deliberately NO cross-network fallback: a request for a network with
# no configured database errors rather than quietly serving the other one's
# rows, which would show real mainnet positions inside a testnet view.
DATABASE_URL=
# Prisma needs a direct (non-pooled) URL for migrations:
DIRECT_URL=

# In production both of these point at the services VM's own Postgres over
# loopback — that is the whole reason the web tier runs on the VM rather than on
# Vercel/Workers, which cannot reach a database bound to localhost. See
# floydex-protocol/infra/a1flex/WEB-TIER.md.
# Per-network overrides (take precedence over DATABASE_URL):
# DATABASE_URL_MAINNET=postgresql://floydex:PASSWORD@127.0.0.1:5432/floydex_mainnet
# DATABASE_URL_TESTNET=postgresql://floydex:PASSWORD@127.0.0.1:5432/floydex_testnet

# ── Solana Network ────────────────────────────────────────────────────────────
# `testnet` is Solana devnet. `mainnet` is mainnet-beta.
NEXT_PUBLIC_SOLANA_NETWORK=testnet
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
NEXT_PUBLIC_PROGRAM_ID=2vgBHV763RtsBZGNpnuvbkGDKJdtt1DxP9tUDo4NZxUB
NEXT_PUBLIC_ASSET_USDC=
# UsePod inference (server-only). Register at https://docs.usepod.ai/using/quickstart/
USEPOD_API_TOKEN=
# Optional extra desk-AI keys if UsePod is not activated (server-only).
# OPENAI_API_KEY=
# GROQ_API_KEY=
# GEMINI_API_KEY=
# ClawPump Partner API (server-only). Never launch a token unless the operator says so.
CLAWPUMP_API_KEY=
NEXT_PUBLIC_ACTIVE_MARKETS=TSLA-PERP,NVDA-PERP,AAPL-PERP,SPY-PERP,META-PERP,AMZN-PERP,QQQ-PERP,MSFT-PERP,COIN-PERP,MSTR-PERP,SOL-PERP,BTC-PERP,ETH-PERP,XLM-PERP
NEXT_PUBLIC_TREASURY=
# Binance Web3 (server-only) — RWA marks. Never commit real values.
BINANCE_API_KEY=
BINANCE_API_SECRET=

# ── Deployed Contract IDs ─────────────────────────────────────────────────────
NEXT_PUBLIC_CONTRACT_GOVERNANCE=
NEXT_PUBLIC_CONTRACT_ORACLE_ADAPTER=
NEXT_PUBLIC_CONTRACT_VAULT=
NEXT_PUBLIC_CONTRACT_ENGINE=
NEXT_PUBLIC_CONTRACT_ORDER_GATEWAY=
NEXT_PUBLIC_CONTRACT_INSURANCE=
NEXT_PUBLIC_CONTRACT_LIQUIDATION=
NEXT_PUBLIC_CONTRACT_RISK=

# ── Asset Contracts ───────────────────────────────────────────────────────────
NEXT_PUBLIC_ASSET_NATIVE_XLM=
NEXT_PUBLIC_ASSET_USDC=
NEXT_PUBLIC_USDC_ISSUER=

# ── WebSocket / App URLs ──────────────────────────────────────────────────────
# One ws-server process can only tail one database, so each network needs its
# own address. When a network's URL is unset the UI falls back to REST polling
# for that network automatically.
#
# NEXT_PUBLIC_WS_URL is the legacy single-network var and applies to
# NEXT_PUBLIC_STELLAR_NETWORK only — it is deliberately NOT inherited by the
# other network, which would point one venue's UI at the other's feed.
NEXT_PUBLIC_WS_URL=
# NEXT_PUBLIC_WS_URL_MAINNET=
# NEXT_PUBLIC_WS_URL_TESTNET=
NEXT_PUBLIC_APP_URL=

# ── Network toggle: which venues are actually live ────────────────────────────
# Drives the "this network is not live" banner. A network with no keepers
# running still renders a structurally valid venue whose order book is simply
# empty — indistinguishable from a quiet market — so a trader could place an
# order and wait forever for a match nothing is running to produce. Set these
# honestly.
#
# Unset means "only the primary network is live", which is the safe reading.
# NEXT_PUBLIC_MAINNET_KEEPERS_LIVE=true
# NEXT_PUBLIC_TESTNET_KEEPERS_LIVE=false

# ── Operator secrets (server-side only, NEVER prefix with NEXT_PUBLIC_) ───────
# Stellar secret keys (S...). ONE ROLE PER KEY — the oracle publisher, matcher
# operator, and liquidator must be three distinct funded accounts. None of them
# may be the contract admin.
# NEVER commit real values here — rotate keys immediately if leaked.
ORACLE_PUBLISHER_SECRET=
MATCHER_OPERATOR_SECRET=
LIQUIDATOR_SECRET=

# The settlement sign route pays fees from the matcher operator account, which
# differs per network — a mainnet key cannot pay on testnet. MATCHER_OPERATOR_SECRET
# above applies to the primary network; set the other one here to let the
# toggle's non-primary venue settle fills.
# MATCHER_OPERATOR_SECRET_MAINNET=
# MATCHER_OPERATOR_SECRET_TESTNET=

# ── Rate limiting (Upstash Redis — REQUIRED in production) ───────────────────
# Without these, production API routes fail closed (deny) on rate-limited
# endpoints: the in-memory fallback is per-instance and useless under scale.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# ── Settlement reconciler tuning ──────────────────────────────────────────────
# How long (minutes) before an unsigned QUEUED TxJob is expired and rolled back
SETTLEMENT_JOB_MAX_AGE_MINUTES=15

# ── Oracle keeper tuning ──────────────────────────────────────────────────────
# Minimum independent price sources (Binance/Coinbase/Kraken) per publish:
# ORACLE_MIN_SOURCES=2
# Max disagreement between sources before the tick is skipped (bps):
# ORACLE_MAX_SOURCE_DEVIATION_BPS=200
# USDC depeg threshold that halts USDC publication (bps off $1):
# USDC_DEPEG_HALT_BPS=100

# ── Liquidation keeper tuning ─────────────────────────────────────────────────
# LIQUIDATION_INTERVAL_MS=5000
# LIQUIDATION_MAX_ACCOUNTS=500

# ── WebSocket server port (for ws-server.ts standalone process) ───────────────
# WS_PORT=8080

# ── Monitor alerting (scripts/monitor.ts, pm2 floydex-monitor) ─────────────────
# Optional webhook that receives alert POSTs as JSON {"content": "..."}.
# A Discord webhook URL works as-is:
#   https://discord.com/api/webhooks/<id>/<token>
# Telegram's Bot API expects {"chat_id","text"} instead, so it needs a tiny
# relay (e.g. a Cloudflare Worker) that remaps the body before forwarding to
#   https://api.telegram.org/bot<TOKEN>/sendMessage
# Alerts fire on: stale oracle >60s, matcher lag >60s, indexer lag >60s,
# DB latency >2s, /api/health down, WebSocket down. De-duplicated: one alert
# on failure, hourly reminders while broken, one recovery notice.
# ALERT_WEBHOOK_URL=

# ── Reflector oracle cross-check (MULTI-MARKET-PLAN §5.2) ─────────────────────
# Reflector is an INDEPENDENT divergence guard on the keeper's 3-source CEX
# median — never the mark price. Its feeds refresh on a 300s resolution, far
# outside the 120s on-chain OracleGuard; a 5-minute mark would mean liquidating
# against a five-minute-old price. When the CEX median and Reflector disagree
# by more than the threshold, the keeper STOPS PUBLISHING that market and the
# on-chain staleness guard fail-stops settlement.
#
# BNB and TRX have no Reflector feed (absent from the External CEX & DEX
# oracle's asset list on both networks) and run on the CEX median alone.
#
# Defaults are safe; uncomment only to override.
# REFLECTOR_GUARD_ENABLED=true
# REFLECTOR_DIVERGENCE_HALT_BPS=300     # 3%; observed normal divergence is 20–100bps
# REFLECTOR_MAX_AGE_SECS=600            # ignore Reflector beyond 2 of its resolutions
# REFLECTOR_CONTRACT_ID=                # defaults by network; see lib/stellar/reflector.ts

# Eight markets are eight separate write_price transactions on one publisher
# account (Soroban allows one host-function invocation per tx, so they cannot
# be batched). Space them so consecutive submissions don't race the sequence
# number. If races persist, move to per-market channel accounts.
# PUBLISH_STAGGER_MS=400

# Admin dashboard (/admin/*) — password login sets an httpOnly session cookie (4h).
# Prefer ADMIN_PASSWORD: ≥24 chars, mixed upper/lower + at least one digit.
# ADMIN_API_KEY is accepted as a fallback password and as the x-admin-key header
# for scripted API calls (same strength rules).
# ADMIN_PASSWORD=
# ADMIN_API_KEY=
