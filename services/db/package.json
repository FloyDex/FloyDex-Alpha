    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@prisma/client": "6.19.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "prisma": "^6.1.0",
    "typescript": "^5.7.3"
  }
}
